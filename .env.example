# =================================================================
# FLIGHT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Neon PostgreSQL Database (Direct High-Speed Connection with asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<neon-hostname>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-host.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# JWT Authentication
JWT_SECRET=YOUR_64_CHAR_HEX_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Temporary Seat Hold Duration (Minutes)
SEAT_HOLD_DURATION_MINUTES=10

# n8n Automation Webhook Coordination
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/flight-events
N8N_WEBHOOK_SECRET=your_n8n_shared_secret_token

# Local ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Groq LLM API Key (For High-Speed LLaMA-3.3 Policy Assistant)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
